{
  "version": 1,
  "device": {
    "name": {
      "type": "string",
      "max_len": 32
    },
    "midi_channel": {
      "type": "int",
      "min": 1,
      "max": 16,
      "default": 1
    }
  },
  "knobs": {
    "count": {
      "type": "int",
      "min": 1,
      "max": 64,
      "default": 8
    },
    "mapping": {
      "curve": {
        "type": "enum",
        "values": [
          "linear",
          "expo",
          "log"
        ],
        "default": "linear"
      },
      "deadband": {
        "type": "int",
        "min": 0,
        "max": 20,
        "default": 2
      },
      "smoothing_alpha": {
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "default": 0.15
      }
    }
  },
  "buttons": {
    "double_click_ms": {
      "type": "int",
      "min": 100,
      "max": 800,
      "default": 350
    },
    "long_press_ms": {
      "type": "int",
      "min": 300,
      "max": 2000,
      "default": 700
    }
  }
}