        "# Week 01 \u2014 Mapping curves\n\nCompare linear vs shaped curves. Decide where precision lives.\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "execution_count": null,
      "outputs": [],
      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "execution_count": null,
      "outputs": [],
      "source": [
        "x=np.linspace(0,1,512)\n",
        "plt.plot(x,x,label='linear')\n",
        "plt.plot(x,x**2.5,label='expo')\n",
        "plt.legend(); plt.show()\n"
      ]
    }
